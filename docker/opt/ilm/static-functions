#!/bin/sh

log() {
    level="${1:-INFO}"
    message="$2"
    # 2022-02-08 15:49:15
    dateString="$(date +%F' '%T)"
    logLevel=$(printf '%-5s' "${level}")
    className="$0"
    processId="$$"
    if [ -z "${message}" ] ; then
        while read -r line ; do
            echo "[$dateString] $logLevel [$className] (process:$processId) ${line}"
        done
    else
        echo "[$dateString] $logLevel [$className] (process:$processId) ${message}"
    fi
}
